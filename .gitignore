/.next/
/out/
/build
/dist
.turbo
.swc

# Environment Files & Secret Credentials
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*firebase-adminsdk*.json

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Testing & Coverage
/coverage
/.nyc_output

# Operating System & File System Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Configurations
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Cloud & Deployment CLI Artifacts
.vercel
.serverless/

